rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Lookup 1: Parent Trip Document (verifies membership & active status)
    function isTripActiveMember(tripId) {
      return isSignedIn() && (
        request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberIds &&
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.status == 'active'
      );
    }

    function isTripMemberRead(tripId) {
      return isSignedIn() && (
        request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberIds
      );
    }

    // Lookup 2: Stop Document (verifies stop ownership)
    function isStopOwner(tripId, stopId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/trips/$(tripId)/stops/$(stopId)).data.uid == request.auth.uid;
    }

    // Deterministic Trip Stop Photo Path: trips/{tripId}/stops/{stopId}/{filename}
    match /trips/{tripId}/stops/{stopId}/{filename} {
      // Allow read for authenticated trip members only (Lookup 1)
      allow read: if isTripMemberRead(tripId);
      
      // Allow photo write for active trip member who owns the stop (2 Firestore document calls max)
      allow write: if isTripActiveMember(tripId)
        && isStopOwner(tripId, stopId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
