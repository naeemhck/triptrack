rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTripMember(tripId) {
      return isSignedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds ||
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
      );
    }

    function isTripOrganizer(tripId) {
      return isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
    }

    function tripIsActive(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.status == 'active';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Invite Codes Lookup Collection
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Trips Collection & Subcollections
    match /trips/{tripId} {
      allow read: if isTripMember(tripId);
      allow create: if isSignedIn();
      
      // Update rules: regular member updates (memberIds sync) or legal organizer lifecycle transitions
      allow update: if isTripMember(tripId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'createdBy', 'id']) ||
        (
          isTripOrganizer(tripId) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          (
            (resource.data.status == 'planned' && request.resource.data.status == 'active') ||
            (resource.data.status == 'active' && request.resource.data.status == 'completed')
          )
        )
      );

      // Members Subcollection:
      match /members/{memberUid} {
        allow read: if isTripMember(tripId) || isOwner(memberUid);
        allow create: if isOwner(memberUid) || isTripOrganizer(tripId);
        allow update: if (
          (isOwner(memberUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharingEnabled', 'sharingMode', 'lastSeenAt', 'displayName', 'avatar'])) ||
          isTripOrganizer(tripId)
        );
        allow delete: if isOwner(memberUid) || isTripOrganizer(tripId);
      }

      // Locations Subcollection: read by trip members, write allowed only if trip is active
      match /locations/{locationUid} {
        allow read: if isTripMember(tripId);
        allow write: if isOwner(locationUid) && tripIsActive(tripId);
      }

      // Stops Subcollection: read by trip members, create/update allowed only if trip is active
      match /stops/{stopId} {
        allow read: if isTripMember(tripId);
        allow create, update: if isTripMember(tripId) && tripIsActive(tripId);
        allow delete: if isTripOrganizer(tripId);
      }
    }

    // Stop Delivery Tracking Subcollection (Admin SDK only)
    match /stopDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // Stale Alert Episodes Tracking Subcollection (Admin SDK only)
    match /staleAlertEpisodes/{episodeId} {
      allow read, write: if false;
      match /deliveries/{deliveryId} {
        allow read, write: if false;
      }
    }
  }
}
