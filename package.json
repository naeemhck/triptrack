{
  "name": "triptrack",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "eslint App.tsx src scripts --max-warnings=0",
    "format:check": "prettier --check App.tsx src scripts *.js *.json *.md",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "verify": "npm run format:check && npm run type-check && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-sharing": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-maps": "1.29.0",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.27.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.ts",
      "src/services/offlineSyncQueue.ts",
      "src/services/supabase/mappers.ts",
      "!src/utils/devLog.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 55,
        "functions": 70,
        "lines": 65,
        "statements": 65
      }
    }
  },
  "private": true
}
