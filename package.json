{
  "name": "triptrack",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:check": "expo export --platform android --output-dir dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint App.tsx jest.setup.ts src scripts --max-warnings=0",
    "format:check": "prettier --check App.tsx jest.setup.ts src scripts .devcontainer *.js *.json *.md",
    "test": "jest --config jest.config.js --runInBand",
    "test:ci": "jest --config jest.config.js --runInBand --coverage",
    "test:db": "supabase test db",
    "verify": "npm run format:check && npm run type-check && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^10.8.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.1.0",
    "supabase": "2.114.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
