EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required later for Expo Push Service token registration.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Optional crash reporting. Leave unset to disable Sentry event delivery.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id

# Local path or EAS file secret for Android FCM configuration.
GOOGLE_SERVICES_JSON=./google-services.json

# Native Google Maps rendering (restrict each key to its app and Maps SDK only).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-sdk-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-sdk-key
