# TripTrack Firebase Configuration
# Copy this file to .env or .env.local and fill in your actual credentials.
# In Expo SDK 49+, variables prefixed with EXPO_PUBLIC_ are automatically exposed to client JS bundle.

EXPO_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="triptrack-your-app.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="triptrack-your-app"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="triptrack-your-app.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Google Maps API Key (Essentials Tier - 10,000 free map loads/month)
# Set up a spending budget alert in Google Cloud Console (Billing -> Budgets & alerts) as safety net.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"
